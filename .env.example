# Meta Model API — https://ai.developer.meta.com
# Paste your key, then restart `npm run dev`. Do not commit `.env`.
MODEL_API_KEY=
LLAMA_API_BASE=https://api.meta.ai/v1
LLAMA_MODEL=muse-spark-1.3

# If you instead have a Llama API key from llama.developer.meta.com:
# LLAMA_API_KEY=
# LLAMA_API_BASE=https://api.llama.com/compat/v1
# LLAMA_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
